# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_api_key_here

# Vercel Blob Storage Token (required for Vercel deployment)
# Get from: https://vercel.com/dashboard/stores
# Only needed when deploying to Vercel
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# App URL (optional, for metadata/sharing)
# In development: http://localhost:3000
# In production: your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
